# Shared password for the cookbook owners (used on /login).
OWNER_PASSWORD=

# Secret used to sign the session cookie. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Production saves are committed to this repo, which triggers a Vercel redeploy.
# Fine-grained token with "Contents: Read and write" on this repo only.
GITHUB_TOKEN=
# owner/name, e.g. sam-smith/cookbook
GITHUB_REPO=
GITHUB_BRANCH=main
